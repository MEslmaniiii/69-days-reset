# ---- Build Your Reset — environment variables ----
# Copy to .env.local for local dev, and set these in Vercel for production.
# NEVER commit real values. .env.local is gitignored.

# --- Public (exposed to the browser; safe because RLS protects the data) ---
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# --- Server-only (used by /api serverless functions; NEVER exposed) ---
# You can reuse VITE_SUPABASE_URL here, or set SUPABASE_URL explicitly.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- AI (server-only) ---
OPENAI_API_KEY=sk-...
# Optional model override (default: gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini
